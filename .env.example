# Copy this file to .env and replace the placeholder values.
# Use Ollama locally for testing, or change this to openai later.
AI_PROVIDER=ollama
# Ollama does not need an API key. Keep your OpenAI key here only if switching back.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:3b
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
DAILY_QUESTION_LIMIT=10
DATABASE_PATH=./data/imas.sqlite
NODE_ENV=development
